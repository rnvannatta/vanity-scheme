#!/bin/bash

echo "Configuring Vanity Scheme"

mkdir -p config/vanity/compiler/
mkdir -p config/x86_64-w64-mingw32/vanity/compiler/

if command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1; then windows_default=y; else windows_default=n; fi
if command -v em-config >/dev/null 2>&1; then wasm_default=y; else wasm_default=n; fi
if command -v bison >/dev/null 2>&1; then have_bison=y; else have_bison=n; fi
if command -v lex >/dev/null 2>&1; then have_lex=y; else have_lex=n; fi

read -p "Major Version:" major
read -p "Minor Version:" minor
read -p "Install Dir:" install
if [ "$windows_default" = "y" ]; then
  read -p "Build Windows backend? (Y/n):" windows
  if [ "$windows" = "n" ]; then windows=n; else windows=y; fi
else
  read -p "Build Windows backend? (y/N):" windows
  if [ "$windows" = "y" ]; then windows=y; else windows=n; fi
fi
if [ "$wasm_default" = "y" ]; then
  read -p "Build WASM backend? (Y/n):" wasm
  if [ "$wasm" = "n" ]; then wasm=n; else wasm=y; fi
else
  read -p "Build WASM backend? (y/N):" wasm
  if [ "$wasm" = "y" ]; then wasm=y; else wasm=n; fi
fi
if [ "$wasm" = "y" ]; then
  read -p "Emscripten Install Dir:" eminstall
fi
read -p "Debug Build? (y/N):" debug
read -p "Optimize? (Y/n):" optimize

if [ -z "$major" ]; then major=0; fi
if [ -z "$minor" ]; then minor=0; fi
if [ -z "$install" ]; then install="/usr/local"; fi
if [ -z "$eminstall" ]; then
  if [ "$wasm_default" = "y" ]; then
    eminstall=`em-config CACHE`;
  elif [ -z $EM_CACHE ]; then
    eminstall="/usr/share/emscripten/cache/sysroot";
  else
    eminstall=$EM_CACHE/sysroot;
  fi
fi
if [ "$debug" = "y" ]; then cflags="-g "; else cflags=""; fi
if [ "$debug" = "y" ]; then scmflags="-g "; else scmflags=""; fi
if [ "$optimize" = "n" ]; then cflags+="-O0"; else cflags+="-O2"; fi
if [ "$optimize" = "n" ]; then scmflags+="-O0"; else scmflags+="-O2"; fi

feature_scmflags=""
if [ "$windows" = "n" ]; then feature_scmflags+="-Ddisable-platform-windows "; fi
if [ "$wasm" = "n" ]; then feature_scmflags+="-Ddisable-platform-emscripten "; fi

if [ "$have_bison" = "n" ] && [ src/ffi.y -nt bootstrap/src/ffi.tab.c ]; then
  echo "warning: bison not found and src/ffi.y is newer than bootstrap/src/ffi.tab.c;"
  echo "         the pre-generated parser may be stale"
fi
if [ "$have_lex" = "n" ] && [ src/ffi.l -nt bootstrap/src/ffi.lex.c ]; then
  echo "warning: lex/flex not found and src/ffi.l is newer than bootstrap/src/ffi.lex.c;"
  echo "         the pre-generated lexer may be stale"
fi

install="${install/#\~/$HOME}"
install=`realpath $install`

echo "Installing Vanity Scheme $major.$minor to $install with extra CFLAGS: $cflags and extra SCMFLAGS: $scmflags"
echo "Windows backend: $windows, WASM backend: $wasm, bison: $have_bison, lex: $have_lex"
if [ "$wasm" = "y" ]; then
  echo "and installing wasm to $eminstall"
fi

echo "MAJOR := $major" > config.mk
echo "MINOR := $minor" >> config.mk
echo "INSTALL_DIR := $install" >> config.mk
echo "EMSCRIPTEN_INSTALL_DIR := $eminstall" >> config.mk
echo "CFLAGS += $cflags" >> config.mk
echo "SCMFLAGS += $scmflags" >> config.mk
echo "FEATURE_SCMFLAGS := $feature_scmflags" >> config.mk
echo "ENABLE_WINDOWS := $windows" >> config.mk
echo "ENABLE_WASM := $wasm" >> config.mk
echo "HAVE_BISON := $have_bison" >> config.mk
echo "HAVE_LEX := $have_lex" >> config.mk

cat << EOF > config/vanity/compiler/config.scm
(define-library (vanity compiler config)
  (export install-root version platform)
  (define version '($major $minor))
  (define install-root "$install/")
  (define platform 'linux))
EOF

cat << EOF > config/x86_64-w64-mingw32/vanity/compiler/config.scm
(define-library (vanity compiler config)
  (export install-root version platform)
  (define version '($major $minor))
  (define install-root #f)
  (define platform 'windows))
EOF
